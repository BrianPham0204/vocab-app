# Piper TTS (binary paths on VPS)
PIPER_BIN=C:\piper\piper\piper.exe
PIPER_EN_MODEL=C:\piper\models\en_US-lessac-medium.onnx
PIPER_EN_CONFIG=C:\piper\models\en_US-lessac-medium.onnx.json

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=vocab-audio
R2_PUBLIC_URL=https://pub-<account_id>.r2.dev
